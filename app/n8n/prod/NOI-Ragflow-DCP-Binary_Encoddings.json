    {
      "parameters": {
        "jsCode": "// Conversion of date fields from ragflow databases\n\nreturn items.map(item => {\n  \n  const data = item.json;\n\n  // Función para formatear la fecha\n  function formatToSupabase(dateString) {\n    if (!dateString || typeof dateString !== 'string') {\n      return null; // O devuelve el valor original\n    }\n\n    const dateObject = new Date(dateString);\n\n    // 1. Obtenemos el string ISO (ej: 2025-10-22T23:32:44.000Z)\n    const isoString = dateObject.toISOString();\n\n    // 2. Quitamos la 'Z' del final\n    //    (Resultado: \"2025-10-22T23:32:44.000\")\n    const withoutZ = isoString.slice(0, -1);\n\n    // 3. Añadimos los 3 ceros extra (microsegundos) y el \"+00:00\"\n    //    (Resultado: \"2025-10-22T23:32:44.000000+00:00\")\n    return withoutZ + \"000+00:00\";\n  }\n\n  // --- create_date conversion ---\n  data.create_date = formatToSupabase(data.create_date);\n\n  // --- update_date conversion ---\n  data.update_date = formatToSupabase(data.update_date);\n\n  // Output\n  return item;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
