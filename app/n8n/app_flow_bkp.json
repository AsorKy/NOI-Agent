      "id": "54626e6f-668a-4d85-9b5d-8b2511d781e4",
      "name": "Upload to Supabase",
      "retryOnFail": true,
      "maxTries": 5,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "python",
        "pythonCode": "import json\n\n# Entradas desde nodos anteriores\ntry:\n  supa_data = _input.item.json.get(\"supabase_docs\", [])   # lista de documentos desde Supabase\n  ragflow_data = _input.item.json.get(\"rag_docs\", {})     # diccionario desde RAGFlow\nexcept Exception as e:\n  return [{\"json\": {\"error\": f\"Invalid input structure: {str(e)}\"}}]\n\n# Archivos ya presentes en RAGFlow\nragflow_files = set(ragflow_data.get(\"file_name\", []))\nresults = []\n\nfor doc in supa_data:\n  try:\n    file_name = doc.get(\"file_name\", \"UNKNOWN\")\n    # ---- CASO 2: campos críticos faltantes o \"NULL\" ----\n    critical_fields = [\"up_status\", \"up_ragflow_status\", \"pross_status\", \"created_at\"]\n    if any(doc.get(f) in [None, \"NULL\"] for f in critical_fields):\n        results.append({\n            \"json\": {\n                \"file_name\": file_name,\n                \"upload_to_ragflow\": False,\n                \"processing\": \"error\",\n                \"info\": doc\n            }\n        })\n        continue\n\n    # ---- CASO 1: listo para subir ----\n    if (\n        doc.get(\"id\") not in [None, \"NULL\"] and\n        doc.get(\"supabase_key\") not in [None, \"NULL\"] and\n        doc.get(\"ragflow_id\") == \"NULL\" and\n        doc.get(\"up_status\") == \"uploaded\" and\n        doc.get(\"up_ragflow_status\") == \"pending\" and\n        doc.get(\"pross_status\") == \"pending\"\n    ):\n        if file_name not in ragflow_files:\n            results.append({\n                \"json\": {\n                    \"file_name\": file_name,\n                    \"upload_to_ragflow\": True,\n                    \"processing\": \"pending\",\n                    \"info\": doc\n                }\n            })\n        else:\n            # ---- CASO 3: archivo ya existe en RAGFlow ----\n            results.append({\n                \"json\": {\n                    \"file_name\": file_name,\n                    \"upload_to_ragflow\": False,\n                    \"processing\": \"duplicate\",\n                    \"info\": doc\n                }\n            })\n    else:\n        # ---- CASO 3: condición inesperada ----\n        results.append({\n            \"json\": {\n                \"file_name\": file_name,\n                \"upload_to_ragflow\": False,\n                \"processing\": \"unhandled\",\n                \"info\": doc\n            }\n        })\n\nexcept Exception as e:\n    # ---- CASO 3: error en procesamiento individual ----\n    results.append({\n        \"json\": {\n            \"file_name\": doc.get(\"file_name\", \"UNKNOWN\"),\n            \"upload_to_ragflow\": False,\n            \"processing\": \"exception\",\n            \"error\": str(e),\n            \"info\": doc\n        }\n    })\n\n\n# Devolver lista procesada en formato compatible con n8n\nreturn results\n"
      },
