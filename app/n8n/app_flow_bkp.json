        "pythonCode": "data = dict(_input.item.json.data)\ndocument_list = data.get(\"docs\", [])\n\nragflow_doc_ids = {\n    \"doc_id\": [],\n    \"pross_status\": [],\n    \"file_name\": [],\n    \"processed_at\": []\n}\n\nfor java_doc in document_list:\n  py_doc = java_doc.to_py()\n  ragflow_doc_ids[\"doc_id\"].append(py_doc.get(\"id\"))\n  ragflow_doc_ids[\"pross_status\"].append(py_doc.get(\"run\"))\n  ragflow_doc_ids[\"file_name\"].append(py_doc.get(\"name\"))\n  ragflow_doc_ids[\"processed_at\"].append(py_doc.get(\"process_begin_at\"))\n\nreturn {\"rag_docs\":ragflow_doc_ids }\n\n\n\n"
