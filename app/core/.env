# ---- Environment variables ----

# ---- RAGFLow settings ----
RAGFLOW_SQL_CONTAINER = "ragflow-mysql"
RAGFLOW_SQL_DATABASE_METADATA = "rag_flow"
RAGFLOW_SQL_ROOT_USER = "root"
RAGFLOW_SQL_ROOT_PASS = "infini_rag_flow"

MINIO_MC_PATH = "C:/mc.exe"  # ruta al binario mc.exe
MINIO_ALIAS = "ragflow"
MINIO_ENDPOINT = "http://localhost:9000"
MINIO_ACCESS_KEY = "rag_flow"       # el valor real de MINIO_ROOT_USER
MINIO_SECRET_KEY = "infini_rag_flow"  # el valor real de MINIO_ROOT_PASSWORD

